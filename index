<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Para vos, Fer 💛</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: env(safe-area-inset-top, 0px); }
:root {
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
body {
  font-family: 'Quicksand', sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  background: #1a1a2e;
  color: #f0e6d3;
}

/* FLOATING */
.floating-emojis {
  position: fixed; top:0; left:0; width:100%; height:100%;
  pointer-events: none; z-index: 0; overflow: hidden;
}
.emoji {
  position: absolute; font-size: 1.2rem;
  animation: floatDown linear infinite; opacity: 0.5;
}
@keyframes floatDown {
  0% { transform: translateY(-5vh) rotate(0deg); opacity: 0; }
  10% { opacity: 0.5; }
  90% { opacity: 0.5; }
  100% { transform: translateY(105vh) rotate(360deg); opacity: 0; }
}

/* SECTIONS */
section {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 4rem 1.5rem; text-align: center;
}

/* HERO */
.hero {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  position: relative;
}
.hero-photo {
  width: 220px; height: 220px; border-radius: 50%;
  overflow: hidden; margin-bottom: 2rem;
  border: 4px solid rgba(232,168,124,0.4);
  box-shadow: 0 0 60px rgba(232,168,124,0.15);
}
.hero-photo img { width:100%; height:100%; object-fit:cover; }
.hero h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 900; font-size: 2.6rem;
  line-height: 1.2; color: #f0e6d3;
  margin-bottom: 0.3rem;
}
.hero .name {
  font-family: 'Playfair Display', serif;
  font-weight: 900; font-size: 3rem;
  background: linear-gradient(135deg, #e8a87c, #d4789c, #85cdca);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero .sub {
  font-size: 1.1rem; color: rgba(240,230,211,0.7);
  margin-top: 1.2rem; font-weight: 500;
}
.scroll-hint {
  margin-top: 3rem; font-size: 0.85rem;
  color: rgba(240,230,211,0.4);
  animation: bounce 2s ease infinite;
}
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(8px); }
}

/* PHRASE SECTION */
.phrase-section {
  background: linear-gradient(180deg, #0f3460 0%, #1a1a2e 100%);
  min-height: 70vh; padding: 5rem 1.5rem;
}
.phrase-card {
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24px; padding: 2.5rem 2rem; max-width: 360px;
}
.phrase-card .icon { font-size: 2.5rem; margin-bottom: 1.2rem; }
.phrase-card p {
  font-size: 1.15rem; line-height: 1.7;
  color: rgba(240,230,211,0.8); font-weight: 500;
}
.phrase-card .highlight {
  color: #e8a87c; font-weight: 700; font-size: 1.2rem;
  display: block; margin-top: 0.8rem;
}

/* PHOTO ROWS */
.photo-row {
  padding: 3rem 1rem;
  display: flex; flex-direction: column; align-items: center;
  gap: 1.5rem;
}
.photo-row.dark { background: #1a1a2e; }
.photo-row.darker { background: #16213e; }
.photo-row.darkest { background: #0f3460; }

.photo-row .caption {
  font-size: 1.1rem; font-weight: 600;
  color: rgba(240,230,211,0.6); margin-bottom: 0.5rem;
  font-style: italic;
}

.photo-grid {
  display: grid; gap: 0.8rem; width: 100%; max-width: 400px;
}
.photo-grid.two { grid-template-columns: 1fr 1fr; }
.photo-grid.three { grid-template-columns: 1fr 1fr; }

.photo-item {
  border-radius: 16px; overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  aspect-ratio: 3/4;
}
.photo-item.wide { aspect-ratio: 4/3; }
.photo-item.square { aspect-ratio: 1; }
.photo-item.span2 { grid-column: span 2; aspect-ratio: 4/3; }
.photo-item img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.5s ease;
}

.single-photo {
  width: 100%; max-width: 340px;
  border-radius: 20px; overflow: hidden;
  box-shadow: 0 8px 40px rgba(0,0,0,0.3);
}
.single-photo img { width:100%; display:block; }

/* MESSAGE */
.message-section {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  min-height: 80vh; padding: 5rem 1.5rem;
}
.msg-card {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 24px; padding: 2.5rem 2rem; max-width: 380px;
}
.msg-card .icon { font-size: 2.5rem; margin-bottom: 1rem; }
.msg-card p {
  font-size: 1.05rem; line-height: 1.8;
  color: rgba(240,230,211,0.85); font-weight: 500;
}

/* REVEAL */
.reveal-section {
  background: linear-gradient(180deg, #16213e 0%, #0f3460 100%);
  min-height: 60vh;
}
.reveal-section h2 {
  font-size: 1.3rem; color: rgba(240,230,211,0.7);
  font-weight: 600; margin-bottom: 1.5rem;
}
.reveal-btn {
  background: linear-gradient(135deg, #e8a87c, #d4789c);
  border: none; border-radius: 50px;
  padding: 1rem 2.5rem;
  font-family: 'Quicksand', sans-serif;
  font-size: 1.1rem; font-weight: 700; color: #fff;
  cursor: pointer;
  box-shadow: 0 6px 30px rgba(232,168,124,0.25);
  transition: transform 0.3s;
  -webkit-tap-highlight-color: transparent;
}
.reveal-btn:active { transform: scale(0.96); }
.hidden-message {
  max-height: 0; overflow: hidden; opacity: 0;
  transition: max-height 0.8s ease, opacity 0.8s ease, margin 0.5s ease;
  margin-top: 0;
}
.hidden-message.show {
  max-height: 500px; opacity: 1; margin-top: 2rem;
}
.hidden-message p {
  font-size: 1.2rem; color: #e8a87c;
  font-weight: 700; line-height: 1.6;
}

/* FINAL */
.final-section {
  background: linear-gradient(180deg, #0f3460 0%, #1a1a2e 100%);
  min-height: 80vh; padding: 5rem 1.5rem 6rem;
}
.heart { font-size: 3.5rem; margin-bottom: 1.5rem; }
.final-section .closing {
  font-size: 1.1rem; color: rgba(240,230,211,0.8);
  line-height: 1.7; max-width: 340px; font-weight: 500;
}
.signature {
  margin-top: 1.5rem;
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem; font-weight: 700;
  background: linear-gradient(135deg, #e8a87c, #d4789c);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* FADE */
.fade-in {
  opacity: 0; transform: translateY(25px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.fade-in.visible { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.15s; }
.delay-2 { transition-delay: 0.3s; }
.delay-3 { transition-delay: 0.45s; }

/* DIVIDER */
.divider {
  width: 60px; height: 2px;
  background: linear-gradient(90deg, transparent, rgba(232,168,124,0.4), transparent);
  margin: 0 auto;
}
</style>
</head>
<body>
<div class="floating-emojis" id="floatingEmojis"></div>

<!-- HERO -->
<section class="hero">
  <div class="hero-photo fade-in">
    <img src="data:image/jpeg;base64," alt="">
  </div>
  <h1>Para vos,</h1>
  <span class="name">Fer</span>
  <p class="sub">Te amo 💛</p>
  <div class="scroll-hint">Seguí bajando ↓</div>
</section>

<!-- PHRASE -->
<section class="phrase-section">
  <div class="phrase-card fade-in">
    <div class="icon">✨</div>
    <p>No pude regalarte flores...</p>
    <span class="highlight">pero cada palabra acá es para vos 💐</span>
  </div>
</section>

<!-- CONCERTS -->
<div class="photo-row darker">
  <p class="caption fade-in">Nuestros recitales 🎸</p>
  <div class="photo-grid two">
    <div class="photo-item fade-in"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-1"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-2"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-3"><img src="data:image/jpeg;base64," alt=""></div>
  </div>
</div>

<!-- FESTIVAL -->
<div class="photo-row dark">
  <p class="caption fade-in">Festival mode 🎶</p>
  <div class="photo-grid two">
    <div class="photo-item fade-in"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-1"><img src="data:image/jpeg;base64," alt=""></div>
  </div>
</div>

<!-- MESSAGE -->
<section class="message-section">
  <div class="msg-card fade-in">
    <div class="icon">🌙</div>
    <p>
      Cada plan con vos es una aventura.
      Desde los recitales gritando juntos,
      hasta las escapadas a la nieve o la playa.
      No importa el lugar, lo que importa es que estés vos.
      Gracias por hacer que todo valga la pena. 💛
    </p>
  </div>
</section>

<!-- SNOW -->
<div class="photo-row darkest">
  <p class="caption fade-in">Aventuras en la nieve ❄️</p>
  <div class="single-photo fade-in">
    <img src="data:image/jpeg;base64," alt="">
  </div>
</div>

<!-- NIGHT & STADIUM -->
<div class="photo-row dark">
  <p class="caption fade-in">Las noches y los estadios 🌃</p>
  <div class="photo-grid two">
    <div class="photo-item fade-in"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-1"><img src="data:image/jpeg;base64," alt=""></div>
  </div>
</div>

<!-- MOVIE -->
<div class="photo-row darker">
  <p class="caption fade-in">Cine y pochoclos 🍿</p>
  <div class="single-photo fade-in">
    <img src="data:image/jpeg;base64," alt="">
  </div>
</div>

<!-- THEME PARK -->
<div class="photo-row dark">
  <p class="caption fade-in">Diversión a full 🎢</p>
  <div class="photo-grid two">
    <div class="photo-item fade-in"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item fade-in delay-1"><img src="data:image/jpeg;base64," alt=""></div>
    <div class="photo-item span2 fade-in delay-2"><img src="data:image/jpeg;base64," alt=""></div>
  </div>
</div>

<!-- BEACH -->
<div class="photo-row darker">
  <p class="caption fade-in">Sol, arena y vos ☀️</p>
  <div class="single-photo fade-in">
    <img src="data:image/jpeg;base64," alt="">
  </div>
</div>

<!-- REVEAL -->
<section class="reveal-section">
  <div class="fade-in">
    <div style="font-size:2rem;margin-bottom:0.5rem;">🦋 ✨</div>
    <h2>¿Querés ver algo más?</h2>
    <button class="reveal-btn" onclick="revealMessage()">Tocá acá 💛</button>
    <div class="hidden-message" id="hiddenMsg">
      <p>Con vos todo es mejor.<br>Te elijo hoy y siempre. 🦋💛</p>
    </div>
  </div>
</section>

<!-- FINAL -->
<section class="final-section">
  <div class="fade-in">
    <div class="heart">💛</div>
    <p class="closing">
      Con todo mi amor, hoy y siempre.
      Gracias por ser mi compañera en cada aventura.
    </p>
    <p class="signature">— Seba</p>
  </div>
</section>

<button onclick="toggleMusic()" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:100;background:rgba(255,255,255,0.12);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.1);border-radius:50px;padding:0.6rem 1.2rem;font-family:'Quicksand',sans-serif;font-size:0.85rem;font-weight:600;color:#f0e6d3;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,0.15);display:flex;align-items:center;gap:0.4rem;-webkit-tap-highlight-color:transparent;margin-bottom:env(safe-area-inset-bottom,0px);">🎵 <span id="musicLabel">poné play</span></button>

<audio id="bgMusic" loop preload="auto"><source src="slide-away.mp3" type="audio/mpeg"></audio>
<script>
const emojis = ['💛','✨','🦋','🌙','⭐','💫'];
const container = document.getElementById('floatingEmojis');
function createEmoji() {
  const el = document.createElement('span');
  el.classList.add('emoji');
  el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
  el.style.left = Math.random() * 100 + '%';
  el.style.animationDuration = (10 + Math.random() * 15) + 's';
  el.style.animationDelay = Math.random() * 3 + 's';
  el.style.fontSize = (0.8 + Math.random() * 0.8) + 'rem';
  container.appendChild(el);
  el.addEventListener('animationend', () => el.remove());
}
for (let i = 0; i < 12; i++) setTimeout(createEmoji, i * 500);
setInterval(createEmoji, 1500);

const audio = document.getElementById("bgMusic");
let playing = false;
function toggleMusic() {
  if (playing) { audio.pause(); } else { audio.play(); }
  playing = !playing;
  document.getElementById("musicLabel").textContent = playing ? "Slide Away ♪" : "poné play";
}

function revealMessage() {
  document.getElementById('hiddenMsg').classList.toggle('show');
}

const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.15 });
document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
</body>
</html>
